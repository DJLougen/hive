{
  "dashboard": {
    "title": "Hive Enterprise",
    "tags": ["hive", "enterprise", "observability"],
    "timezone": "UTC",
    "schemaVersion": 36,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Routing Rate (ops/s)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(hive_routing_total[1m])",
            "legendFormat": "{{source}} — {{action}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Routing Latency (p50 / p95 / p99)",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(hive_routing_latency_ms_bucket[1m]))", "legendFormat": "p50"},
          {"expr": "histogram_quantile(0.95, rate(hive_routing_latency_ms_bucket[1m]))", "legendFormat": "p95"},
          {"expr": "histogram_quantile(0.99, rate(hive_routing_latency_ms_bucket[1m]))", "legendFormat": "p99"}
        ],
        "fieldConfig": {"defaults": {"unit": "ms", "min": 0}},
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Memory Read Hit Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "hive_memory_reads_total{hit=\"true\"} / (hive_memory_reads_total{hit=\"true\"} + hive_memory_reads_total{hit=\"false\"})",
            "legendFormat": "hit rate"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 0.8}]}}},
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Memory Writes",
        "type": "stat",
        "targets": [
          {"expr": "hive_memory_writes_total", "legendFormat": "writes"}
        ],
        "fieldConfig": {"defaults": {"unit": "short"}},
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8}
      },
      {
        "id": 5,
        "title": "Tenant Isolation Status",
        "type": "table",
        "targets": [
          {"expr": "hive_tenant_active_nodes", "format": "table", "instant": true}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "timeseries",
        "targets": [
          {"expr": "rate(hive_errors_total[1m])", "legendFormat": "{{source}}"}
        ],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.01}]}}},
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      }
    ]
  }
}
