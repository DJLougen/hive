@@ -14,7 +14,10 @@ from .normalize import canonical
 
 def build_key(fn_name: str, args: Sequence[Any] = (), kwargs: Mapping[str, Any] | None = None) -> str:
     positional = "(" + ",".join(canonical(a) for a in args) + ")"
+    # Keyword arguments are unordered by definition, so the rendering is too:
+    # the caller's spelling must not decide whether the cache hits.
     keywords = "{" + ",".join(
-        f"{name}={canonical(value)}" for name, value in (kwargs or {}).items()
+        f"{name}={canonical(value)}"
+        for name, value in sorted((kwargs or {}).items())
     ) + "}"
     return f"{fn_name}|{positional}|{keywords}"
