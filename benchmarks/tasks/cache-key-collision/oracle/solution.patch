+    """Cache ``fn``'s results under keys built from each call's arguments.
+
+    The key is built from the arguments *bound to the parameters*, not from the
+    way the caller happened to spell them: ``f(1, 2)``, ``f(a=1, b=2)`` and
+    ``f(1)`` (``b`` defaulted) are one call and must share an entry.
+    """
     def decorate(func: F) -> F:
         memo = store if store is not None else MemoStore()
+        params = signature(func)
 
         @wraps(func)
         def wrapper(*args: Any, **kwargs: Any) -> Any:
-            key = build_key(func.__name__, args, kwargs)
+            bound = params.bind(*args, **kwargs)
+            bound.apply_defaults()
+            key = build_key(func.__name__, (), bound.arguments)
             return memo.get_or_compute(key, lambda: func(*args, **kwargs))
 
         wrapper.store = memo  # type: ignore[attr-defined]
