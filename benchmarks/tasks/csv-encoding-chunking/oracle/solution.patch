+"""Finding record boundaries in a stream of text.
+
+The scanner is a *stream* scanner: record boundaries are decided by quote state,
+so the state and the partially-read record have to survive from one chunk to the
+next. Scanning each chunk on its own cannot work — a boundary inside a quoted
+field is indistinguishable from a record terminator unless the scanner
+remembers that it was inside quotes when the previous chunk ended.
+"""
 
 from __future__ import annotations
 
@@ -6,33 +13,60 @@ QUOTE = '"'
 NEWLINE = "\n"
 
 
+class RecordScanner:
+    """Incremental record splitter. Feed chunks, get whole records back."""
+
+    def __init__(self, *, quote: str = QUOTE, newline: str = NEWLINE) -> None:
+        self.quote = quote
+        self.newline = newline
+        self._buffer: list[str] = []
+        self._in_quotes = False
+
+    @property
+    def in_quotes(self) -> bool:
+        """True when the stream has an unterminated quoted field so far."""
+        return self._in_quotes
+
+    def feed(self, chunk: str) -> list[str]:
+        """Return every record completed by ``chunk`` (terminators stripped)."""
+        records: list[str] = []
+        i = 0
+        while i < len(chunk):
+            char = chunk[i]
+            if char == self.quote:
+                if self._in_quotes and i + 1 < len(chunk) and chunk[i + 1] == self.quote:
+                    self._buffer.append(self.quote)
+                    self._buffer.append(self.quote)
+                    i += 2
+                    continue
+                self._in_quotes = not self._in_quotes
+                self._buffer.append(char)
+            elif char == self.newline and not self._in_quotes:
+                records.append("".join(self._buffer))
+                self._buffer = []
+            else:
+                self._buffer.append(char)
+            i += 1
+        return records
+
+    def finish(self) -> list[str]:
+        """Return the last record when the stream did not end with a terminator."""
+        if self._in_quotes:
+            raise ValueError("unterminated quoted field at end of stream")
+        if not self._buffer:
+            return []
+        record = "".join(self._buffer)
+        self._buffer = []
+        return [record]
+
