index 0000000..c587908
--- /dev/null
+++ b/intervals/gaps.py
@@ -0,0 +1,27 @@
+"""The uncovered runs between what is covered.
+
+Merging answers "what is covered"; callers that schedule the *free* time need
+the complement, and the complement of a union of closed runs is again a set of
+closed runs — the maximal stretches of integers that no interval covers and
+that lie between two covered integers.
+"""
+
+from __future__ import annotations
+
+from .merge import merge
+from .model import Interval
+
+
+def gaps(intervals: list[Interval]) -> list[Interval]:
+    """Return the maximal uncovered runs strictly between covered integers.
+
+    The empty space beyond the first and last covered integer is not a gap: a
+    gap is a hole in the coverage. Input order, overlap and duplication do not
+    matter — the answer is the same as for the merged coverage.
+    """
+    runs = merge(intervals)
+    holes: list[Interval] = []
+    for left, right in zip(runs, runs[1:]):
+        if right.start > left.end + 1:
+            holes.append(Interval(left.end + 1, right.start - 1))
+    return holes
